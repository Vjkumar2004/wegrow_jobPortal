# ==============================================================
# WEGROW JOB PORTAL - BACKEND API CONFIGURATION
# ==============================================================
# 
# To switch backends, comment/uncomment the lines below:
# 
# --------------------------------------------------------------
# [MODE 1] LOCAL BACKEND (Runs on localhost:5000)
# --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# --------------------------------------------------------------
# [MODE 2] LIVE BACKEND (Deployed on Vercel)
# --------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://wegrow-jobportal-backend.vercel.app/api/v1
# NEXT_PUBLIC_API_BASE_URL=https://wegrow-jobportal-backend.vercel.app/api/v1
